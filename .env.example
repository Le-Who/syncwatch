# NEXT_PUBLIC_SUPABASE_URL: URL to the Supabase project
# Required for database persistence of rooms and playback snapshots.
NEXT_PUBLIC_SUPABASE_URL="https://ehxftybnvteuuagjiplq.supabase.co"

# SUPABASE_SERVICE_ROLE_KEY: Server-only Supabase service role secret.
# Required for server.ts to bypass RLS and upsert room state. Never expose this
# value to the browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY="replace-with-your-supabase-service-role-key"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# JWT_SECRET: Required in production to sign the HttpOnly session cookie.
JWT_SECRET="replace-with-a-long-random-production-secret"

# NEXT_PUBLIC_APP_URL: Canonical HTTP(S) app origin. Required in production for
# Socket.IO origin checks; localhost is accepted for local development.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# TRUST_PROXY: Set to true only behind a proxy that removes client-supplied
# X-Forwarded-* headers and forwards a verified client address.
TRUST_PROXY="false"
